{"type":"FeatureCollection","features":[{"type":"Feature","geometry":{"type":"GeometryCollection","geometries":[{"type":"Point","coordinates":[144.15693196026086,-36.79700083658585]},{"type":"Polygon","coordinates":[[[144.13118275372503,-36.776175642687974],[144.12826451030935,-36.81562723649327],[144.18319615093466,-36.81782603048372],[144.18559941021238,-36.77755060431316],[144.13118275372503,-36.776175642687974]]]}]},"properties":{"feedType":"warning","cap":{"category":"CBRNE","event":"Chemical Hazard","eventCode":"chemical","urgency":"Expected","severity":"Minor","certainty":"Unknown","contact":"max.x.o'callaghan@emv.vic.gov.au","senderName":"Country Fire Authority","responseType":"Monitor"},"sourceOrg":"EMV","sourceId":"42453","sourceFeed":"cop-cap","sourceTitle":"Advice","id":"42453","category1":"Advice","category2":"CBRNE","status":"Minor","name":"Advice","action":"Stay Informed","statewide":"N","location":"Lockwood, Lockwood North","created":"2026-07-29T18:34:33+10:00","updated":"2026-07-29T18:34:34+10:00","webHeadline":null,"webBody":"<div style=\"margin-bottom:20px\">This <b>Advice</b> message is being issued for <span title=\"warning_locality\" class=\"param\" contenteditable=\"false\">Lockwood, Lockwood North</span>.&nbsp;<div><ul><li>There is a hazardous&nbsp;<span class=\"editable editable-click editable-unsaved\" data-type=\"select\" data-emptytext=\"[gas/material/liquid/solid/fumes]\" data-value=\"1\" contenteditable=\"false\" style=\"display: inline;\" data-source=\"{&quot;0&quot;:&quot;gas&quot;,&quot;1&quot;:&quot;material&quot;,&quot;2&quot;:&quot;liquid&quot;,&quot;3&quot;:&quot;solid&quot;,&quot;4&quot;:&quot;fumes&quot;}\" data-original-title=\"\" title=\"\">material</span>&nbsp;<span class=\"editable editable-click editable-unsaved\" data-type=\"select\" data-emptytext=\"[leak/spill]\" data-value=\"1\" contenteditable=\"false\" style=\"display: inline;\" data-source=\"{&quot;0&quot;:&quot;leak&quot;,&quot;1&quot;:&quot;spill&quot;}\" data-original-title=\"\" title=\"\">spill</span>&nbsp;<span class=\"editable editable-click editable-unsaved\" data-type=\"select\" data-emptytext=\"[in/at/on]\" data-value=\"2\" contenteditable=\"false\" style=\"display: inline;\" data-source=\"{&quot;0&quot;:&quot;in&quot;,&quot;1&quot;:&quot;at&quot;,&quot;2&quot;:&quot;on&quot;}\" data-original-title=\"\" title=\"\">on</span>&nbsp;<span class=\"editable editable-click editable-unsaved\" data-type=\"text\" data-emptytext=\"[road/landmark/business/building]\" data-value=\"Calder Alternative Highway, Lockwood\" contenteditable=\"false\" style=\"display: inline;\" data-original-title=\"\" title=\"\">Calder Alternative Highway, Lockwood</span>.</li><li>This Advice message replaces the Advice issued at 4:30 PM.&nbsp;</li></ul></div></div><div style=\"font-size: 120%; font-weight: bold; margin-bottom:20px\">There is currently no threat to\nthe community, but you should continue to stay informed and monitor conditions. </div><div style=\"margin-bottom:20px\"><b>What you should do:</b><div><ul><li>Keep the roads clear so emergency services can respond.</li></ul></div></div><div style=\"margin-bottom:20px\"><div><b>Impacts in your area:</b></div><div><ul><li>Emergency services will remain in the area as they clean up the spill.</li><li>There may be road closures in the area. Visit <a href=\"https://traffic.transport.vic.gov.au/\" title=\"\" target=\"_blank\">VicTraffic</a>&nbsp;to stay updated.</li></ul></div></div><div style=\"margin-bottom:20px\">This message was issued\nby <span title=\"warning_issuing_agency\" class=\"param\" contenteditable=\"false\">Country Fire Authority</span>.&nbsp;<div><br></div><div><b>The next update is expected by </b><span title=\"warning_next_update\" class=\"param\" contenteditable=\"false\">29/07/2026 08:10 pm</span><b>&nbsp;or as the situation changes.&nbsp;</b></div><div><br></div><div><div><b>Use multiple sources to stay informed:</b>&nbsp;</div></div><div><ul><li><a href=\"http://emergency.vic.gov.au/respond/\" title=\"www.emergency.vic.gov.au\" target=\"_blank\">www.emergency.vic.gov.au</a></li><li><a href=\"https://vicemergency.zendesk.com/hc/en-gb/articles/115001055007-What-is-the-VicEmergency-Hotline-\" title=\"\" target=\"_blank\" style=\"background-color: white;\">VicEmergency Hotline</a>&nbsp;- freecall 1800 226\n226</li><li><a href=\"https://vicemergency.zendesk.com/hc/en-gb/articles/230492607-What-is-the-VicEmergency-app-\" title=\"\" target=\"_blank\">VicEmergency app</a></li><li><a href=\"https://www.facebook.com/vicemergency\" title=\"\" target=\"_blank\"> Facebook</a> or&nbsp;<a href=\"https://twitter.com/vicemergency\" title=\"Twitter\" target=\"_blank\">Twitter</a>&nbsp;(#vichazmat)</li><li>Tune in to ABC Local Radio, commercial and designated community radio stations, or Sky News TV.</li></ul><div><b>Accessibility:</b></div></div><div>The following services can\nhelp you, or someone you know, access information during an emergency. </div><div><ul><li>To access this information in other languages call the <a href=\"https://www.tisnational.gov.au/\" title=\"\" target=\"_blank\">Translating\nand Interpreting Service</a>&nbsp;on&nbsp;131\n450&nbsp;(freecall) and ask them to call VicEmergency Hotline.</li><li>If you are deaf, hard of\nhearing, or have a speech/communication impairment contact the&nbsp;<a href=\"https://www.infrastructure.gov.au/media-communications-arts/phone/services-people-disability/accesshub/national-relay-service\" title=\"\" target=\"_blank\">National\nRelay Service</a>&nbsp;and ask them to call the VicEmergency Hotline. </li></ul></div></div>","text":"ADVICE - CHEMICAL HAZARD - Stay Informed\nIncident Location: Calder Alternative Highway, Lockwood\nIssue Date: Wednesday 29 July 2026, 06:34 pm\nNext Update: Wednesday 29 July 2026, 08:10 pm\n\nMore details at http://emergency.vic.gov.au/respond/#!/warning/42453/moreinfo\n\nThis Advice message is being issued for Lockwood, Lockwood North. \n- There is a hazardous material spill on Calder Alternative Highway, Lockwood.\n- This Advice message replaces the Advice issued at 4:30 PM. \n\n\nThere is currently no threat to the community, but you should continue to stay informed and monitor conditions. \n\n","sizeFmt":null,"incidentFeatures":[{"properties":{"feedType":"incident","sourceOrg":"EMV","sourceId":"42453","sourceFeed":"cop-cap","sourceTitle":"Advice","id":"42453","category1":"CBRNE","category2":"Chemical Hazard","name":"Advice","location":"Calder Alternative Highway, Lockwood","created":"2026-07-29T18:34:33+10:00","updated":"2026-07-29T18:34:34+10:00","webHeadline":null,"sizeFmt":null}}]}},{"properties":{"status":"Safe","estaId":125145060,"feedType":"incident","source":"000","sourceOrg":"VIC/ESTA","sourceId":125145060,"sourceFeed":"esta-cad-event","sourceTitle":"Clayton","eventId":"F260721826","id":"ESTA:260721826","suppress":false,"category1":"Fire","category2":"Structure Fire","created":"2026-07-29T09:58:28.000Z","updated":"2026-07-29T10:05:05.040Z","resources":3,"location":"Evelyn St, Clayton"},"type":"Feature","geometry":{"type":"Point","coordinates":[145.13020829960575,-37.92201886331365]}},{"properties":{"status":"Responding","estaId":125145148,"feedType":"incident","source":"000","sourceOrg":"VIC/CFA","sourceId":287273,"sourceFeed":"cfa-incident","sourceTitle":"Glenelg Hwy","eventId":260721828,"id":"ESTA:260721828","suppress":false,"category1":"Fire","category2":"Other","created":"2026-07-29T10:11:00.000Z","updated":"2026-07-29T10:11:00.000Z","resources":0,"location":"Glenelg Hwy, Wickliffe","cfaId":287273,"size":"Small","sizeFmt":"Small"},"type":"Feature","geometry":{"type":"Point","coordinates":[142.65547507275147,-37.66508781741345]}},{"properties":{"status":"Under Control","estaId":125139612,"feedType":"incident","source":"PAL","sourceOrg":"VIC/CFA","sourceId":287211,"sourceFeed":"cfa-incident","sourceTitle":"","eventId":260721612,"id":"ESTA:260721612","suppress":false,"category1":"Hazardous Material","category2":"Hazar